{
  "name": "autocall-next",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next start",
    "lint": "eslint src prisma/*.mjs scripts/*.mjs next.config.mjs postcss.config.js tailwind.config.js --quiet",
    "lint:report": "eslint src prisma/*.mjs scripts/*.mjs next.config.mjs postcss.config.js tailwind.config.js",
    "verify": "prisma validate && npm run test:seed-policy && npm run test:regional-preferences && npm run test:safe-redirect && npm run test:locales && npm run lint && npm run build",
    "db:pull": "prisma db pull",
    "db:push": "node -e \"if(process.env.NODE_ENV==='production')throw new Error('db:push is forbidden in production; use npm run db:migrate');\" && prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "node -e \"if(process.env.NODE_ENV==='production')throw new Error('Migration reset is forbidden in production.');\" && prisma migrate reset",
    "db:seed": "node prisma/seed.mjs",
    "test:seed-policy": "node --test prisma/seed-policy.test.mjs",
    "test:regional-preferences": "node --test src/lib/regional-preferences.test.mjs",
    "test:safe-redirect": "node --test src/lib/safe-redirect.test.mjs",
    "test:locales": "node --test src/locales/locales.test.mjs",
    "key:generate": "node scripts/generate-key.mjs",
    "worker": "node scripts/worker.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@paper-design/shaders-react": "^0.0.81",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "i18next": "^25.10.10",
    "jose": "^5.10.0",
    "lucide-react": "^0.577.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^16.6.6",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.4",
    "@grpc/grpc-js": "^1.13.6",
    "deepmerge-ts": "^8.0.2"
  }
}
