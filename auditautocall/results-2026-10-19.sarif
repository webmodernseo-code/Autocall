{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [{
    "tool": {
      "driver": {
        "name": "AutoCall local security audit",
        "version": "2026-10-19",
        "rules": [
          {"id":"AC-SEC-2026-001","name":"tenant-controlled-ssrf","shortDescription":{"text":"SSRF via tenant-controlled WhatsWay base URL"},"properties":{"security-severity":"8.1","tags":["security","CWE-918"]}},
          {"id":"AC-SEC-2026-002","name":"plaintext-operational-secrets","shortDescription":{"text":"Operational credentials stored as plaintext"},"properties":{"security-severity":"8.0","tags":["security","CWE-312"]}},
          {"id":"AC-SEC-2026-003","name":"unbounded-unvalidated-body","shortDescription":{"text":"Unbounded request body and unvalidated availability object"},"properties":{"security-severity":"5.3","tags":["security","CWE-400","CWE-20"]}},
          {"id":"AC-SEC-2026-004","name":"secret-in-query-string","shortDescription":{"text":"Meta OAuth client secret sent in query string"},"properties":{"security-severity":"5.0","tags":["security","CWE-598"]}}
        ]
      }
    },
    "results": [
      {"ruleId":"AC-SEC-2026-001","level":"error","message":{"text":"A tenant-controlled base_url reaches server-side fetch without the existing SSRF guard."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/lib/services/messaging.js"},"region":{"startLine":185}}}]},
      {"ruleId":"AC-SEC-2026-002","level":"error","message":{"text":"WhatsApp credentials are persisted without application encryption; the same pattern affects SIP, ElevenLabs and Meta secrets."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/app/api/app/messaging/whatsapp/accounts/route.js"},"region":{"startLine":56}}}]},
      {"ruleId":"AC-SEC-2026-003","level":"warning","message":{"text":"Availability accepts an unbounded, unvalidated object after unbounded JSON parsing."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/app/api/app/availability/route.js"},"region":{"startLine":48}}}]},
      {"ruleId":"AC-SEC-2026-004","level":"warning","message":{"text":"The Meta OAuth client secret and code are embedded in the outbound URL query."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/app/api/app/messaging/whatsapp/accounts/route.js"},"region":{"startLine":36}}}]}
    ]
  }]
}
